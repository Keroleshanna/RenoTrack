<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables `dotnet user-secrets`, the recommended source for the DevelopmentBootstrap account
         passwords (D64). WebApplication.CreateBuilder registers the user-secrets configuration
         provider only when the environment is Development, so a credential stored here cannot reach
         a Production host at all — a gate independent of DevelopmentBootstrap's own. -->
    <UserSecretsId>renotrack-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned above the transitive default (2.0.0) to close GHSA-v5pm-xwqc-g5wc (high severity). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RenoTrack.Application\RenoTrack.Application.csproj" />
    <ProjectReference Include="..\RenoTrack.Infrastructure\RenoTrack.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Top-level statements compile into an internal Program class. RenoTrack.Api.Tests needs to
         name it as WebApplicationFactory<Program>'s entry point. Granting access to exactly one
         named test assembly is preferred over making Program public to every consumer, matching
         the same choice already made for RenoTrack.Domain/RenoTrack.Domain.Tests (D7). -->
    <InternalsVisibleTo Include="RenoTrack.Api.Tests" />
  </ItemGroup>

</Project>
