<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Top-level statements compile into an internal Program class. RenoTrack.Website.Tests needs
         to name it as WebApplicationFactory<Program>'s entry point. Granting access to exactly one
         named test assembly is preferred over making Program public to every consumer — the same
         choice already made for RenoTrack.Api/RenoTrack.Api.Tests and RenoTrack.Domain (D7). -->
    <InternalsVisibleTo Include="RenoTrack.Website.Tests" />
  </ItemGroup>

</Project>
